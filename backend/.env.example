[TEMPLATE]
# Backend Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ────────────────────────────────────────────────────────────────
#
# Local development:
#   DB_URL=jdbc:mysql://localhost:3306/rehan_portfolio?allowPublicKeyRetrieval=true&useSSL=false&defaultAuthenticationPlugin=mysql_native_password
#   DB_USERNAME=root
#   DB_PASSWORD=
#
# Aiven MySQL (production):
#   DB_URL=jdbc:mysql://mysql-30b3ef2c-rehanjirayat-4bd2.j.aivencloud.com:14343/defaultdb?sslmode=REQUIRED
#   DB_USERNAME=avnadmin
#   DB_PASSWORD=<your-aiven-password>

DB_URL=jdbc:mysql://localhost:3306/rehan_portfolio?allowPublicKeyRetrieval=true&useSSL=false&defaultAuthenticationPlugin=mysql_native_password
DB_USERNAME=root
DB_PASSWORD=

# Hibernate DDL auto mode: validate | update | create | create-drop
# Use "validate" in production, "update" for development
JPA_DDL_AUTO=update

# Server
SERVER_PORT=8080

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Resend HTTPS API) - used for contact form email notifications
# Sign up at https://resend.com and generate an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Contact form notification recipient
CONTACT_NOTIFICATION_EMAIL=rehanjirayat@gmail.com
