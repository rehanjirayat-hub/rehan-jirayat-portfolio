# Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DB_URL=jdbc:mysql://localhost:3306/rehan_portfolio?allowPublicKeyRetrieval=true&useSSL=false&defaultAuthenticationPlugin=mysql_native_password
DB_USERNAME=root
DB_PASSWORD=

# Hibernate DDL auto mode: validate | update | create | create-drop
# Use "validate" in production, "update" for development
JPA_DDL_AUTO=update

# Server
SERVER_PORT=8080

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mail (SMTP) - used for contact form email notifications
# For Gmail: host=smtp.gmail.com, port=587, enable App Password
# For production: use your hosting provider's SMTP settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Contact form notification recipient
CONTACT_NOTIFICATION_EMAIL=
